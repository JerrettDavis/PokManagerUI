<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PokManagerBuild</RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <PackageReference Include="ReportGenerator" Version="5.5.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PokManager.sln" />
  </ItemGroup>

  <ItemGroup>
    <!-- 10.0.10 patches GHSA-cvvh-rhrc-wg4q / GHSA-g8r8-53c2-pm3f / GHSA-23rf-6693-g89p /
         GHSA-8q5v-6pqq-x66h / GHSA-mmjf-rqrv-855v (high severity) present in 10.0.9. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
  </ItemGroup>

</Project>
